# result: [false, "fallback", "fallback"]

substrings = ["x"]
contains_all_result = contains_all({ substrings = [1]; "x" }, substrings) ?? false

fields_ordering = ["a"]
encode_key_value_result = encode_key_value(
    { fields_ordering = [1]; {"a": 1} },
    fields_ordering,
) ?? "fallback"

reordered_fields_ordering = ["a"]
reordered_encode_key_value_result = encode_key_value(
    fields_ordering: reordered_fields_ordering,
    value: { reordered_fields_ordering = [1]; {} },
) ?? "fallback"

[contains_all_result, encode_key_value_result, reordered_encode_key_value_result]
